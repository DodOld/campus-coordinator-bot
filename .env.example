# Never commit .env. Use Docker secrets or your deployment secret manager in production.
TELEGRAM_BOT_TOKEN=
# Optional SOCKS5 or HTTP(S) proxy used only for Telegram Bot API requests.
TELEGRAM_PROXY_URL=
VK_API_TOKEN=
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://campus_bot:change-me@db:5432/campus_bot
ALLOWED_CHAT_IDS=-1001234567890
# Per-chat routing. `null` is valid only for a non-forum chat root.
TOPIC_POLICY_JSON={"-1001234567890":{"debug":101,"posts":102,"schedule":103}}
# Operator-maintained candidate users for !all. Do not commit real values.
MEMBER_IDS_JSON=[]
VK_API_VERSION=5.199
VK_POLL_INTERVAL_SECONDS=60
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=INFO
# The Docker image builds this from the checked-in Go sources.
GO_SCHEDULE_BINARY=/usr/local/bin/schedule-bot
GO_SCHEDULE_TIMEOUT_SECONDS=60
